# Vercel Marketplace > Upstash Redis가 자동 연결하는 변수 (권장).
# 서버 전용입니다. PUBLIC_ 접두사를 붙이지 마세요.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash 콘솔에서 직접 생성한 Redis의 변수 이름도 지원합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 선택 사항. production / preview는 VERCEL_ENV로 자동 분리됩니다.
# Preview 배포들끼리는 같은 preview 저장 공간을 사용합니다.
# SCHEDULE_NAMESPACE=preview
